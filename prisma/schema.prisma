// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  timezone          String   @default("America/New_York")
  notificationPrefs Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cards         UserCard[]
  usage         Usage[]
  notifications Notification[]
  sessions      Session[]
}

model LoginChallenge {
  email       String   @id
  codeHash    String
  nonce       String
  expiresAt   DateTime
  attempts    Int      @default(0)
  requestedAt DateTime @default(now())
  windowStart DateTime @default(now())
  requests    Int      @default(0)
}

model Session {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id])
  @@index([expiresAt])
}

model Card {
  id         String   @id @default(cuid())
  name       String
  issuer     String
  annualFee  Float
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  perks     Perk[]
  userCards UserCard[]
  deals     Deal[]
}

model UserCard {
  id          String    @id @default(cuid())
  userId      String
  cardId      String
  renewalDate DateTime?
  expirationDate DateTime?
  last4       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
  card Card @relation(fields: [cardId], references: [id])

  @@unique([userId, cardId])
}

model Perk {
  id                 String    @id @default(cuid())
  cardId             String
  name               String
  description        String?
  maxValue           Float
  periodValue        Float?
  decemberBonus      Float     @default(0)
  valueKind          String    @default("credit")
  sourceUrl          String?
  verifiedAt         DateTime?
  validUntil         DateTime?
  retired            Boolean   @default(false)
  requiresConfirmation Boolean @default(false)
  perUseLimit        Float?
  periodType         String // "annual", "quarterly", "semi-annual", "monthly", "one-time"
  startDate          DateTime?
  endDate            DateTime?
  enrollmentRequired Boolean   @default(false)
  category           String?   // "travel", "dining", "shopping", "entertainment", "wellness"
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  card  Card    @relation(fields: [cardId], references: [id])
  usage Usage[]
  @@index([cardId])
}

model Usage {
  id        String   @id @default(cuid())
  userId    String
  perkId    String
  amount    Float
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
  deletedAt DateTime?
  idempotencyKey String?
  needsReview Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
  perk Perk @relation(fields: [perkId], references: [id])
  @@unique([userId, idempotencyKey])
  @@index([userId, perkId, date])
}

model Deal {
  id          String    @id @default(cuid())
  title       String
  description String
  cardIds     String[] // Array of card IDs this deal applies to
  expiryDate  DateTime?
  source      String // "doctor-of-credit", "the-points-guy", etc.
  sourceUrl   String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  cards Card[]
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // "expiring", "available", "deal", "reminder"
  title     String
  message   String
  metadata  Json?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PerkRevision {
  id String @id @default(cuid())
  perkId String
  userId String
  data Json
  createdAt DateTime @default(now())
  @@index([perkId, createdAt])
}

model EmailDelivery {
  key String @id
  userId String
  payload Json
  createdAt DateTime @default(now())
  sentAt DateTime?
  lastError String?
  @@index([userId, createdAt])
}
